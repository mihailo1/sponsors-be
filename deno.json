{
  "tasks": {
    "start": "docker compose up --build",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "watch": [
    "server.ts",
    "routes/",
    "react-app/build/",
    "deps.ts"
  ],
  "nodeModulesDir": true,
  "importMap": "./import_map.json",
  "compilerOptions": {
    "strict": true
  },
  "include": [
    "api/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}